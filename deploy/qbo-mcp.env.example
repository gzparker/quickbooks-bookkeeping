# Template for ~/.qbo/tokens.env on the orchestrator host.
#
# Copy to ~/.qbo/tokens.env (chmod 600) and fill in real values. Never commit
# the filled-in copy.
#
# The server both READS this file at startup and REWRITES it when QuickBooks
# rotates the refresh token, so it must stay writable by the service user.
# Expect QUICKBOOKS_REFRESH_TOKEN to change underneath you; that is normal.
#
# QUICKBOOKS_TOKEN_STORE_PATH is deliberately NOT set here. The server resolves
# it before loading this file, so setting it here has no effect - it goes in the
# systemd unit's Environment= instead.

# From the app's Keys & Credentials tab at developer.intuit.com.
QUICKBOOKS_CLIENT_ID=
QUICKBOOKS_CLIENT_SECRET=

# Produced by the one-time OAuth handshake; see RUNBOOK.md.
# The refresh token lapses after ~100 days of no use.
QUICKBOOKS_REFRESH_TOKEN=
QUICKBOOKS_REALM_ID=

# Must match a Redirect URI registered on the Intuit app exactly.
# Sandbox may use http://localhost:8000/callback; production requires public HTTPS.
QUICKBOOKS_REDIRECT_URI=https://qbo.webpixelpro.com/callback

# sandbox | production
QUICKBOOKS_ENVIRONMENT=sandbox
