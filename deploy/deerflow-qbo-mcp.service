# Template. Substitute before installing (RUNBOOK.md §4 has the sed one-liner):
#   __SERVICE_USER__  service account that owns ~/.qbo (the AdLoop host user)
#   __HOME__          that user's home directory, absolute
#   __MCP_PROXY__     absolute path to mcp-proxy (`command -v mcp-proxy`)
# These are '#' comments so an un-stripped header is still a valid unit file.

[Unit]
Description=QuickBooks Online MCP server (stdio) bridged to HTTP by mcp-proxy
Documentation=https://github.com/gzparker/quickbooks-bookkeeping
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=__SERVICE_USER__
WorkingDirectory=__HOME__/.local/share/qbo-mcp

# Bind to loopback only. Public reachability is the tunnel's job, and binding
# to 0.0.0.0 would expose an unauthenticated MCP server on the host's public
# interface, bypassing Cloudflare Access entirely.
#
# The QUICKBOOKS_* values MUST be passed as `-e KEY VALUE` pairs, not via
# Environment=. mcp-proxy builds the child's environment from scratch:
#
#     base_env: dict[str, str] = {}
#     if args_parsed.pass_environment:
#         base_env.update(os.environ)
#
# and --pass-environment defaults to False. So Environment= would set these on
# mcp-proxy and they would never reach Node - the three DISABLE flags would
# silently not apply, and the server would come up with all 142 tools
# registered including 71 create/update/delete, with nothing in the journal to
# say so. Verify with the tools/list assertion in RUNBOOK.md after any edit.
ExecStart=__MCP_PROXY__ \
    /usr/bin/node __HOME__/.local/share/qbo-mcp/dist/index.js \
    --host 127.0.0.1 --port 8091 --allow-origin='*' \
    -e QUICKBOOKS_TOKEN_STORE_PATH __HOME__/.qbo/tokens.env \
    -e QUICKBOOKS_DISABLE_WRITE true \
    -e QUICKBOOKS_DISABLE_UPDATE true \
    -e QUICKBOOKS_DISABLE_DELETE true

Restart=on-failure
RestartSec=5s

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=__HOME__/.qbo

StandardOutput=journal
StandardError=journal
SyslogIdentifier=qbo-mcp

[Install]
WantedBy=multi-user.target
